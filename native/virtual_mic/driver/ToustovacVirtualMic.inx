; ToustovacVirtualMic.inf - Toustovač Clean Microphone (WaveRT, capture only).
;
; Root-enumerated endpoint. Product-owned GUIDs (generated once, committed
; in native/virtual_mic/README.md):
;   control interface : {A3F5D6B1-2C8E-4A7F-9B1D-6E2F0C8A4417}
;   endpoint (mic)    : {B72E94C4-1D3F-5A86-BC0A-9D7421E3F2B0}
;
; Hardware ID: ROOT\VIVERRA\TOUSTOVAC_CLEAN_MIC. The endpoint name is the
; friendly name below; abbreviated UI alias kept by the same GUID pair so Edge
; device selection stays stable across restart and in-place upgrade.

[Version]
Signature   = "$WINDOWS NT$"
Class       = MEDIA
ClassGuid   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %Viverra%
CatalogFile = ToustovacVirtualMic.cat
DriverVer   = 09/19/2026,1.0.0.0
PnPLockdown = 0

[DestinationDirs]
DefaultDestDir = 12
ToustovacVirtualMic.CopyList = 12

[SourceDisksNames]
1 = %DiskId%,,

[SourceDisksFiles]
ToustovacVirtualMic.sys = 1

; NTamd64 matches the 64-bit SetupAPI; the generic NT section is the fallback
; so the 32-bit (WOW64) SetupAPI also resolves a model section instead of
; returning "Operation not allowed in WOW64".
[Manufacturer]
%Viverra% = Viverra, NTamd64
%Viverra% = Viverra, NT

[Viverra.NTamd64]
%Toustovac.Clean.Mic.Name% = ToustovacVirtualMic, ROOT\VIVERRA\TOUSTOVAC_CLEAN_MIC

[Viverra.NT]
%Toustovac.Clean.Mic.Name% = ToustovacVirtualMic, ROOT\VIVERRA\TOUSTOVAC_CLEAN_MIC

[ToustovacVirtualMic]
AlsoInstall = ks.registration(ks.inf),wdmaudio.registration(wdmaudio.inf)
CopyFiles   = ToustovacVirtualMic.CopyList
AddReg      = ToustovacVirtualMic.AddReg

[ToustovacVirtualMic.CopyList]
ToustovacVirtualMic.sys

[ToustovacVirtualMic.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,ToustovacVirtualMic.sys
HKR,Drivers,SubClasses,,"wave,midi,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%Toustovac.Clean.Mic.Name%
HKR,Drivers\midi\wdmaud.drv,Description,,%Toustovac.Clean.Mic.Name%
HKR,Drivers\mixer\wdmaud.drv,Description,,%Toustovac.Clean.Mic.Name%

[ToustovacVirtualMic.Interfaces]
; KS audio categories keep the standard GUIDs.  The private control
; interface (broker-only, SDDL-restricted inside the driver) is registered
; by the driver itself (IoRegisterDeviceInterface), not from this INF.
AddInterface = %KSCATEGORY_AUDIO%, "TOP", InterfaceTOP
AddInterface = %KSCATEGORY_CAPTURE%, "TOP", InterfaceTOP

[InterfaceTOP]
AddReg = InterfaceAddReg

[InterfaceAddReg]
; Standard, documented media-category registration only; the IPolicyConfig
; default-mic is left untouched on purpose.
HKR,,%KSCATEGORY_AUDIO%,,TOP

[Strings]
Viverra                  = "Viverra"
DiskId                   = "Toustovac Clean Microphone Driver Disk"
Toustovac.Clean.Mic.Name = "Toustovač Clean Microphone"
KSCATEGORY_AUDIO         = "{6994AD00-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_CAPTURE       = "{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
